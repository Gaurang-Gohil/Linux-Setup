/* Wallpaper effects menu with previews (SUPER+SHIFT+W).
   Grid of thumbnails: each effect already applied to your current wallpaper. */
@theme "~/.config/rofi/wallust/colors-rofi.rasi"

configuration {
    show-icons:      true;
    hover-select:    true;
    me-select-entry: "MouseSecondary";
    me-accept-entry: "MousePrimary";
    font:            "Inter Medium 11";
}

* {
    selected:      @selected-normal-background;
    text-color:    @foreground;
    border-color:  @selected;
}

window {
    width:            80%;
    location:         center;
    anchor:           center;
    transparency:     "real";
    border:           2px;
    border-radius:    14px;
    border-color:     @selected;
    background-color: #000000b3;
}

mainbox {
    children:         [ "inputbar", "listview" ];
    background-color: transparent;
    padding:          14px;
    spacing:          10px;
}

inputbar {
    children:         [ "prompt", "entry" ];
    background-color: transparent;
    padding:          6px 10px;
    spacing:          10px;
}
prompt {
    background-color: transparent;
    text-color:       @selected;
}
entry {
    background-color: transparent;
    placeholder:       "type to filter…";
    placeholder-color: #ffffff4d;
}

listview {
    columns:          6;
    lines:            3;
    fixed-columns:    true;
    fixed-height:     true;
    cycle:            true;
    scrollbar:        false;
    spacing:          14px;
    padding:          6px;
    background-color: transparent;
}

element {
    orientation:      vertical;
    spacing:          8px;
    padding:          8px;
    border-radius:    10px;
    cursor:           pointer;
    background-color: #00000033;
}
element selected.normal {
    background-color: @selected;
    text-color:       #000000;
}
element alternate.normal {
    background-color: #00000033;
}

element-icon {
    size:             130px;
    cursor:           inherit;
    background-color: transparent;
    horizontal-align: 0.5;
}
element-text {
    cursor:           inherit;
    background-color: transparent;
    text-color:       inherit;
    horizontal-align: 0.5;
}
